# Copy to .env in the repository root. Use a local-only password.
POSTGRES_DB=date_planner
POSTGRES_USER=date_planner
POSTGRES_PASSWORD=local_dev_change_me
# URL-encode special characters in the password when editing DATABASE_URL.
DATABASE_URL=postgresql://date_planner:local_dev_change_me@localhost:5432/date_planner?schema=public
API_PORT=3000
WEB_PORT=5173
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api/v1
# TASK-03 / TASK-05: leave blank until implemented.
KAKAO_REST_API_KEY=
VITE_KAKAO_JAVASCRIPT_KEY=
